# Production settings for docker-compose.yml. Copy to ".env.production" on the
# server (never commit it) and fill in every value. See DEPLOY.md.

# ── Domains (DNS A records must point at this server) ───────────────────────
SITE_DOMAIN=tickets.example.com
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt account email (certificate expiry notices)
ACME_EMAIL=you@example.com

# ── Supabase (Project Settings → API) ───────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key — safe in the browser
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET: full database access. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ticket emails (Gmail: an App password, not your login password) ─────────
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MoEvent <your-address@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ── Bot protection on the booking form (strongly recommended) ───────────────
# Cloudflare dashboard → Turnstile → Add site (both domains). Free.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
