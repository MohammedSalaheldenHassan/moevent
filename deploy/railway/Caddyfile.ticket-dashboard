# Admin dashboard on Railway. Railway terminates HTTPS and sets PORT.
# API_ORIGIN / SUPABASE_URL are set by Dockerfile.static.

{
	auto_https off
	admin off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# geolocation: the event form's "My location" button.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		# Map tiles + place search: OpenStreetMap. Images: Supabase Storage.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' {$API_ORIGIN} {$SUPABASE_URL} wss://*.supabase.co https://nominatim.openstreetmap.org; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Keep the dashboard out of search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	root * /srv
	try_files {path} /index.html
	file_server
}
