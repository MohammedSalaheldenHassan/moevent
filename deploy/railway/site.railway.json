{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile.static",
    "watchPatterns": ["artifacts/events-site/**", "lib/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "deploy/railway/Dockerfile.static", "deploy/railway/Caddyfile.events-site"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
