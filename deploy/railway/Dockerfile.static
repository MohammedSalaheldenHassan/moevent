# Railway services: public site and dashboard (static apps served by Caddy,
# which adds the security headers). Built from the repo root.
#
# APP selects which one: events-site | ticket-dashboard
# (set in site.railway.json / dashboard.railway.json via the APP variable).
# VITE_* values are baked into the bundle at build time; Railway passes the
# service's variables in as build args.

FROM node:22-bookworm-slim AS build
ARG APP
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE
ARG VITE_TURNSTILE_SITE_KEY=""
RUN test -n "$APP" || (echo "Set the APP variable to events-site or ticket-dashboard" && exit 1) \
 && test -n "$VITE_SUPABASE_URL" -a -n "$VITE_SUPABASE_ANON_KEY" -a -n "$VITE_API_BASE" \
    || (echo "Set VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY and VITE_API_BASE on this service" && exit 1)
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_API_BASE=$VITE_API_BASE \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
RUN npm install -g pnpm@10.18.0
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter "@workspace/${APP}..."
RUN pnpm --filter "@workspace/${APP}" run build \
 && mkdir /out && cp -r "artifacts/${APP}/dist/public/." /out/

FROM caddy:2.8-alpine
ARG APP
ARG VITE_SUPABASE_URL
ARG VITE_API_BASE
COPY deploy/railway/Caddyfile.${APP} /etc/caddy/Caddyfile
COPY --from=build /out /srv
# Origins used in the Content-Security-Policy. The API origin is VITE_API_BASE
# without any trailing /api (a CSP source with a path only matches that path).
ENV SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_API_BASE=$VITE_API_BASE
CMD ["sh", "-c", "export API_ORIGIN=$(printf '%s' \"$VITE_API_BASE\" | sed -E 's#/+$##; s#/api$##; /^https?:\\/\\//!s#^#https://#'); exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile"]
