{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile.api",
    "watchPatterns": ["artifacts/api-server/**", "lib/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "deploy/railway/Dockerfile.api"]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
