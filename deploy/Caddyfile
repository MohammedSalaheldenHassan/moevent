# Caddy gets and renews HTTPS certificates automatically for both domains.
# SITE_DOMAIN / ADMIN_DOMAIN / ACME_EMAIL / SUPABASE_URL come from the
# environment (docker-compose.yml). Both apps call /api on their own origin,
# so the API needs no CORS.

{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001 {
			# One proxy hop: the API trusts exactly this (TRUST_PROXY_HOPS=1).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Hashed build assets never change; HTML must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
}

# ── Public site ──────────────────────────────────────────────────────────────
{$SITE_DOMAIN} {
	import common

	header {
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Maps: OpenStreetMap embed. Bot check: Cloudflare Turnstile.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' {$SUPABASE_URL}; frame-src https://www.openstreetmap.org https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}

# ── Admin dashboard ──────────────────────────────────────────────────────────
{$ADMIN_DOMAIN} {
	import common

	header {
		X-Frame-Options "DENY"
		# geolocation: the event form's "My location" button.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		# Map tiles + place search: OpenStreetMap. Images: Supabase Storage.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' {$SUPABASE_URL} wss://*.supabase.co https://nominatim.openstreetmap.org; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Keep the dashboard out of search engines.
		X-Robots-Tag "noindex, nofollow"
	}

	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}
