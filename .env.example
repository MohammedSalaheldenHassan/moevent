# Copy to ".env" in this folder (repo root). Supabase: Project Settings → API.

VITE_SUPABASE_URL=https://lzkitwefaxolgnuwdvuk.supabase.co
# Must be the anon / default public / publishable key (browser-safe). Never paste service_role here.
VITE_SUPABASE_ANON_KEY=

# Same Supabase project URL as VITE_SUPABASE_URL (API server). Required if your project is not the default template URL.
SUPABASE_URL=

# Server-only — never expose to Vite or the browser
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URL for Drizzle / server routes that use @workspace/db (optional until you use those features)
DATABASE_URL=

# Optional: ticket emails over SMTP (defaults to Gmail: smtp.gmail.com, port 465).
# For Gmail, SMTP_PASS is a 16-character App password, not your normal password.
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MoEvent <your-address@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Public URL of the Express API (same host as dev, or your Railway API hostname). If you omit /api, it is appended automatically.
# Example: VITE_API_BASE=https://ticket-hub-api-production.up.railway.app
# VITE_API_BASE=

# Local dev (optional; api-server defaults to 3001, Vite proxies /api)
# PORT=3001
# API_SERVER_URL=http://127.0.0.1:3001

# Optional: Cloudflare Turnstile bot check on the public booking form.
# Free at dash.cloudflare.com → Turnstile. Both set = on; both empty = off.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Production only: comma-separated origins allowed to call the API cross-origin.
# Not needed with the Docker/Caddy setup (site, dashboard and /api share an origin).
# CORS_ORIGINS=
