# Copy to ".env" in this folder (repo root). Supabase: Project Settings → API.

VITE_SUPABASE_URL=https://lzkitwefaxolgnuwdvuk.supabase.co
# Must be the anon / default public / publishable key (browser-safe). Never paste service_role here.
VITE_SUPABASE_ANON_KEY=

# Server-only — never expose to Vite or the browser
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URL for Drizzle / server routes that use @workspace/db (optional until you use those features)
DATABASE_URL=

# Optional: transactional email (issue-ticket flows)
# RESEND_API_KEY=

# Optional overrides
# PORT=3001
# API_SERVER_URL=http://127.0.0.1:3001
