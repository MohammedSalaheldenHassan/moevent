{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');for(const f of['package-lock.json','yarn.lock']){try{fs.unlinkSync(f)}catch{}};const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "dev": "pnpm exec kill-port 3001 5173 5174 && concurrently -k -n api,dashboard -c cyan,magenta \"pnpm run dev:api\" \"pnpm exec wait-on http://127.0.0.1:3001/api/healthz && pnpm --filter @workspace/ticket-dashboard run dev\"",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:dashboard": "pnpm --filter @workspace/ticket-dashboard run dev",
    "dev:site": "pnpm --filter @workspace/events-site run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "proxy-addr": "^2.0.8",
      "body-parser": "^2.4.0",
      "qs": "^6.16.1",
      "ws": "^8.21.0",
      "fflate": "^0.8.3"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "wait-on": "^8.0.5",
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
